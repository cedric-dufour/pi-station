## Generated by Ansible (docker))

## Automatic startup of Docker Compose'd application
[Unit]
Description=Automatic startup of Docker Compose'd application
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%I
ExecStart=/usr/bin/docker compose up --detach
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=180
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
