## Generated by Ansible (mqtt)
# REF: https://mosquitto.org/man/mosquitto-conf-5.html

# Security
{% if MQTT_MOSQUITTO_SECURITY_PER_LISTENER | bool %}
per_listener_settings true
{% else %}
per_listener_settings false
{% for key, value in (MQTT_MOSQUITTO_SECURITY_DEFAULT | combine(MQTT_MOSQUITTO_SECURITY, recursive=True) | dictsort) %}
{% if value is boolean %}
{{ key }} {{ value | ternary('true', 'false') }}
{% else %}
{{ key }} {{ value }}
{% endif %}
{% endfor %}
{% endif %}

# Listeners
{% for listener, config in (MQTT_MOSQUITTO_LISTENERS | dictsort) %}
listener {{ listener }}
{% for key, value in (config | dictsort) %}
{% if value is boolean %}
{{ key }} {{ value | ternary('true', 'false') }}
{% else %}
{{ key }} {{ value }}
{% endif %}
{% endfor %}
{% endfor %}

# Persistence
{% if MQTT_MOSQUITTO_PERSISTENCE_ENABLE | bool %}
persistence true
{% for key, value in (MQTT_MOSQUITTO_PERSISTENCE_DEFAULT | combine(MQTT_MOSQUITTO_PERSISTENCE, recursive=True) | dictsort) %}
{% if value is boolean %}
{{ key }} {{ value | ternary('true', 'false') }}
{% else %}
{{ key }} {{ value }}
{% endif %}
{% endfor %}
{% else %}
persistence false
{% endif %}

# Logging
{% for key, value in (MQTT_MOSQUITTO_LOGGING_DEFAULT | combine(MQTT_MOSQUITTO_LOGGING, recursive=True) | dictsort) %}
{% if value is iterable and value is not string %}
{% set values = value %}
{% else %}
{% set values = [value] %}
{% endif %}
{% for value in values %}
{% if value is boolean %}
{{ key }} {{ value | ternary('true', 'false') }}
{% else %}
{{ key }} {{ value }}
{% endif %}
{% endfor %}
{% endfor %}
