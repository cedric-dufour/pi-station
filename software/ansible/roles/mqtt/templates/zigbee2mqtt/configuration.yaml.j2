---
## Generated by Ansible (mqtt)
# REF: https://www.zigbee2mqtt.io/guide/configuration/

# !!! WARNING !!! WARNING !!! WARNING !!! WARNING !!! WARNING !!! WARNING !!!
#          This configuration will be overwritten by the application
#                     (and all its  comments discarded)
# !!! WARNING !!! WARNING !!! WARNING !!! WARNING !!! WARNING !!! WARNING !!!

# Adapter; REF: https://www.zigbee2mqtt.io/guide/configuration/adapter-settings.html
serial:
  {{ MQTT_ZIGBEE_ADAPTER_DEFAULT | combine(MQTT_ZIGBEE_ADAPTER, recursive=True) | to_yaml(indent=2) | indent(width=2) }}

# MQTT broker; REF: https://www.zigbee2mqtt.io/guide/configuration/mqtt.html
mqtt:
  {{ MQTT_ZIGBEE_BROKER_DEFAULT | combine(MQTT_ZIGBEE_BROKER, recursive=True) | to_yaml(indent=2) | indent(width=2) }}

# Frontend; REF: https://www.zigbee2mqtt.io/guide/configuration/frontend.html
{% if MQTT_ZIGBEE_FRONTEND_ENABLE | bool %}
{% if MQTT_ZIGBEE_FRONTEND | length %}
frontend:
  {{ MQTT_ZIGBEE_FRONTEND | to_yaml(indent=2) | indent(width=2) }}
{% else %}
frontend: true
{% endif %}
{% else %}
frontend: false
{% endif %}

# Home Assistant; REF: https://www.zigbee2mqtt.io/guide/configuration/homeassistant.html
{% if MQTT_ZIGBEE_HA_ENABLE | bool %}
{% if MQTT_ZIGBEE_HA | length %}
homeassistant:
  {{ MQTT_ZIGBEE_HA | to_yaml(indent=2) | indent(width=2) }}
{% else %}
homeassistant: true
{% endif %}
{% else %}
homeassistant: false
{% endif %}

# Devices and Groups; https://www.zigbee2mqtt.io/guide/configuration/devices-groups.html
permit_join: {{ MQTT_ZIGBEE_DEVICES_JOIN_ENABLE | bool | ternary('true', 'false') }}
# (keep the devices and groups in a separate file)
devices: devices.yaml
groups: groups.yaml

# Advanced; REFs:
# - https://www.zigbee2mqtt.io/guide/configuration/zigbee-network.html
# - https://www.zigbee2mqtt.io/guide/configuration/logging.html
advanced:
  {{ MQTT_ZIGBEE_ADVANCED_DEFAULT | combine(MQTT_ZIGBEE_ADVANCED, recursive=True) | to_yaml(indent=2) | indent(width=2) }}
